# Токен от @BotFather. Обязательно.
BOT_TOKEN=

# Файл БД. В Docker путь внутри контейнера, том смонтирован в ./data
DB_PATH=data/family.db

# Таймзона семьи по умолчанию и время утреннего дайджеста
TZ_DEFAULT=Europe/Moscow
DIGEST_TIME=08:00

# Период тикера напоминаний. В dev удобно ставить 5
TICK_SECONDS=60

# Догонка пропущенного: до LATE_SILENT_MIN минут — молча,
# до LATE_SUMMARY_HOURS часов — с пометкой, дольше — одной сводкой
LATE_SILENT_MIN=10
LATE_SUMMARY_HOURS=12

# Живая панель дня: через сколько сообщений в чате перевыпускать панель
# и на сколько секунд склеивать серию правок в одно редактирование
PANEL_MAX_MESSAGES=20
PANEL_DEBOUNCE_SECONDS=2

# Ежедневный бэкап (этап 6). Копии кладутся в `data/backups/` через
# `VACUUM INTO`, а не копированием файла: у базы включён WAL, и копия
# работающей базы может оказаться битой. 0 = ежедневный снимок выключен
BACKUP_KEEP=7

# Утренняя уборка чата (этап 11): на сколько message_id назад заглядывать.
# 0 = уборка выключена. Боту нужны права администратора «удалять сообщения» —
# без них он молча пропустит уборку и напишет об этом в лог.
# Это же число служит потолком догонки: если ПК простоял несколько суток,
# бот вычистит только последнюю тысячу сообщений и не будет пытаться дальше
SWEEP_WINDOW=1000

# OpenRouter (этап 3a). Без ключа бот работает, но свободный текст не разбирает
# и на обращение отвечает «попробуйте /new».
# Проверено на minimax/minimax-m3:free
OPENROUTER_KEY=
OPENROUTER_MODEL=

# Цепочка разбора (этап 12): `вендор:модель`, через запятую, в порядке
# перебора. Пусто = берётся одна OPENROUTER_MODEL, как было до этапа 12.
# Вендоры: `groq:` и `openrouter:` (без префикса подразумевается openrouter).
#
# Смысл цепочки не в качестве моделей, а в НЕЗАВИСИМОСТИ ОТКАЗОВ. 01.09.2026
# разбор встал целиком, потому что у minimax/minimax-m3:free провайдер ровно
# один — GMICloud, — и он ответил 401. Разные вендоры дают независимость
# надёжнее, чем разные провайдеры внутри одного OpenRouter: у последних общий
# фронт, общий биллинг и общая страница статуса.
#
# Замер 01.09.2026 на реальном промпте бота (5 фраз, включая «каждый второй
# вторник месяца» и список покупок):
#   groq:openai/gpt-oss-120b                        1.4 с, 5/5 верного JSON
#   openrouter:minimax/minimax-m3:free              2.0 с
#   openrouter:dots-studio/dots-3-note-preview:free 3.1 с
# Groq стоит первым: он втрое быстрее и даёт 1000 запросов в сутки.
#
# Три ловушки при подборе звена:
#   1) Провайдер (или вендор) обязан быть ДРУГИМ. minimax/minimax-m2.7:free не
#      годится — у неё тот же GMICloud, что у основной, падать будут вместе.
#   2) OpenRouter'у мы шлём provider.data_collection=deny (приватность, шаг
#      3a.0), и это сужает выбор: nvidia/nemotron-3-super-120b-a12b:free
#      отвечает 404 «No endpoints found matching your data policy». Модель
#      существует — просто её провайдер учится на бесплатных запросах.
#      Лечится другой моделью, а не снятием deny.
#   3) У Groq лимит по токенам в минуту (8000), а системный промпт бота —
#      около 1200 токенов на вызов. Пять фраз подряд упрутся в него и получат
#      429; для семейного чата это не проблема, но знать стоит.
LLM_MODELS=groq:openai/gpt-oss-120b,openrouter:minimax/minimax-m3:free

# Ключ и прокси Groq для РАЗБОРА. Пусто = берутся из STT_* ниже: аккаунт один,
# и вторая строка с тем же секретом развела бы их со временем
GROQ_KEY=
GROQ_PROXY=

# Порог автосохранения без карточки подтверждения (этап 3b): разбор с
# confidence не ниже этого числа записывается сразу. 0 = выключено, спрашивать
# всегда. Включать осознанно и только посмотрев на parse.log
AUTOSAVE_CONFIDENCE=0

# Сколько ЗАПРОСОВ к моделям в сутки себе позволяем — на всю цепочку разом
# (этап 12: считаются запросы, а не фразы, и неудачные тоже — их провайдер
# тоже считает). Провайдер о приближении не предупреждает, он просто начинает
# отвечать 429, и разбор молча деградирует до dateparser. Считаем сами по
# parse.log и говорим об этом в чате. 0 = не ограничивать.
# Ориентир: у Groq 1000 запросов в сутки, у OpenRouter с купленными кредитами
# тоже 1000; 200 — это тормоз на случай зацикливания, а не рабочий потолок
LLM_DAILY_LIMIT=200

# Расшифровка голосовых (этап 5). Ключ бесплатный, карта не нужна:
# console.groq.com. Без ключа кнопка «🎤 Голосом» честно говорит, что голос
# выключен, остальной бот работает как раньше.
# Формат ogg/opus Telegram уходит как есть — ffmpeg не нужен
STT_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions

# Потолок длины голосового (секунды) и срок жизни приглашения после нажатия
# кнопки «🎤 Голосом»: голосовое позже этого срока разобрано не будет
VOICE_MAX_SECONDS=120
VOICE_WINDOW_SECONDS=300

# Прокси. Пусто = напрямую. Формат: http://user:pass@host:port
TELEGRAM_PROXY=
OPENROUTER_PROXY=
STT_PROXY=
