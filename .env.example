# Токен от @BotFather. Обязательно.
BOT_TOKEN=

# Файл БД. В Docker путь внутри контейнера, том смонтирован в ./data
DB_PATH=data/family.db

# Таймзона семьи по умолчанию и время утреннего дайджеста
TZ_DEFAULT=Europe/Moscow
DIGEST_TIME=08:00

# Период тикера напоминаний. В dev удобно ставить 5
TICK_SECONDS=60

# Догонка пропущенного: до LATE_SILENT_MIN минут — молча,
# до LATE_SUMMARY_HOURS часов — с пометкой, дольше — одной сводкой
LATE_SILENT_MIN=10
LATE_SUMMARY_HOURS=12

# Живая панель дня: через сколько сообщений в чате перевыпускать панель
# и на сколько секунд склеивать серию правок в одно редактирование
PANEL_MAX_MESSAGES=20
PANEL_DEBOUNCE_SECONDS=2

# Ежедневный бэкап (этап 6). Копии кладутся в `data/backups/` через
# `VACUUM INTO`, а не копированием файла: у базы включён WAL, и копия
# работающей базы может оказаться битой. 0 = ежедневный снимок выключен
BACKUP_KEEP=7

# Утренняя уборка чата (этап 11): на сколько message_id назад заглядывать.
# 0 = уборка выключена. Боту нужны права администратора «удалять сообщения» —
# без них он молча пропустит уборку и напишет об этом в лог.
# Это же число служит потолком догонки: если ПК простоял несколько суток,
# бот вычистит только последнюю тысячу сообщений и не будет пытаться дальше
SWEEP_WINDOW=1000

# OpenRouter (этап 3a). Без ключа бот работает, но свободный текст не разбирает
# и на обращение отвечает «попробуйте /new».
# Проверено на minimax/minimax-m3:free
OPENROUTER_KEY=
OPENROUTER_MODEL=

# Порог автосохранения без карточки подтверждения (этап 3b): разбор с
# confidence не ниже этого числа записывается сразу. 0 = выключено, спрашивать
# всегда. Включать осознанно и только посмотрев на parse.log
AUTOSAVE_CONFIDENCE=0

# Сколько обращений к модели в сутки себе позволяем. У бесплатного тира
# OpenRouter лимит на аккаунт: 50 без пополнения, 1000 после разовой покупки
# кредитов на $10. Провайдер о приближении не предупреждает — он просто
# начинает отвечать 429, и разбор молча деградирует до dateparser. Считаем
# сами по parse.log и говорим об этом в чате. 0 = не ограничивать
LLM_DAILY_LIMIT=45

# Расшифровка голосовых (этап 5). Ключ бесплатный, карта не нужна:
# console.groq.com. Без ключа кнопка «🎤 Голосом» честно говорит, что голос
# выключен, остальной бот работает как раньше.
# Формат ogg/opus Telegram уходит как есть — ffmpeg не нужен
STT_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions

# Потолок длины голосового (секунды) и срок жизни приглашения после нажатия
# кнопки «🎤 Голосом»: голосовое позже этого срока разобрано не будет
VOICE_MAX_SECONDS=120
VOICE_WINDOW_SECONDS=300

# Прокси. Пусто = напрямую. Формат: http://user:pass@host:port
TELEGRAM_PROXY=
OPENROUTER_PROXY=
STT_PROXY=
